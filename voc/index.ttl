@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix dc:  <http://purl.org/dc/elements/1.1/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix pav:  <http://purl.org/pav/> .
@prefix so:  <http://schema.org/> .
@prefix adms:  <http://www.w3.org/ns/adms#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix locn: <http://www.w3.org/ns/locn#> .

@prefix dob: <https://w3id.org/dob/voc#> .
@prefix did: <https://w3id.org/dob/id/> .
@prefix dop: <https://w3id.org/dob/voc/prop#> .

#########################################################
### Core Classes
#########################################################

dob:Result a rdf:Class, owl:Class ;
    rdfs:label "Result"@en ;
    rdfs:comment "A discrete unit of information that describes some entity." ;
    skos:example "This includes data derived as part of a software process, sensor data and observations from datasets." ;
    rdfs:subClassOf prov:Entity .

dob:QualifiedIdentifier a rdf:Class, owl:Class ;
    rdfs:label "Qualified Identifier" ;
    rdfs:comment "This class qualifies the relation between a resource and its identifier. This includes providing provenance information, status and confidence levels, and relating the source dataset or matching process used."@en ;
    rdf:subClassOf dob:Result .

dob:QualifiedGeospatialRelation a rdf:Class, owl:Class ;
    rdfs:label "Qualified Geospatial Relation" ;
    rdfs:comment "This class qualifies a geospatial relation between two entities. This includes providing provenance information, status and confidence levels, and relating the source dataset or matching process used."@en ;
    rdf:subClassOf dob:Result .

#########################################################
### Geospatial Feature Classes
#########################################################

dob:Thoroughfare a rdfs:Class , owl:Class ;
    rdfs:label "Thoroughfare"@en ;
    rdfs:comment "A thoroughfare is a road or path between two places."@en ;
    rdfs:subClassOf prov:Entity , geo:Feature .

dob:Street a rdfs:Class , owl:Class ;
    rdfs:label "Street"@en ;
    rdfs:comment "A street is a public road in a city or town, typically with houses and buildings on one or both sides."@en ;
    rdfs:subClassOf prov:Entity , geo:Feature , dob:Thoroughfare .

dob:OutputArea a rdf:Class , owl:Class ;
    rdfs:label "Output Area"@en ;
    rdfs:comment "Output Areas (OAs) are the smallest geographic units used for publishing Census 2021 statistics in England and Wales. Designed to maintain consistent population and household sizes, they typically contain 40–250 households and 100–625 usual residents. For 2021, OAs were updated from their 2011 versions to reflect demographic changes: unchanged where they still met size thresholds, and otherwise split or merged accordingly. About 200 boundaries were also adjusted to better align with ward boundaries. Some OAs may exceed the usual population range in special cases, such as large prisons."@en ;
    rdfs:seeAlso <https://www.ons.gov.uk/methodology/geography/ukgeographies/censusgeographies/census2021geographies> ;
    rdfs:subClassOf prov:Entity , geo:Feature .

dob:LowerLayerSuperOutputArea a rdf:Class , owl:Class ;
    rdfs:label "Lower Layer Super Output Area"@en ;
    rdfs:comment "Lower Layer Super Output Areas (LSOAs) are geographic units used for publishing Census 2021 statistics in England and Wales. LSOAs are made up of groups of OAs, usually four or five. They comprise between 400 and 1,200 households and have a usually resident population between 1,000 and 3,000 persons."@en ;
    rdfs:seeAlso <https://www.ons.gov.uk/methodology/geography/ukgeographies/censusgeographies/census2021geographies> ;
    rdfs:subClassOf prov:Entity , geo:Feature .

dob:MiddleLayerSuperOutputArea a rdf:Class , owl:Class ;
    rdfs:label "Middle Layer Super Output Area"@en ;
    rdfs:comment "Middle layer Super Output Areas (MSOAs) are made up of groups of LSOAs, usually four or five. They comprise between 2,000 and 6,000 households and have a usually resident population between 5,000 and 15,000 persons. MSOAs fit within local authorities."@en ;
    rdfs:seeAlso <https://www.ons.gov.uk/methodology/geography/ukgeographies/censusgeographies/census2021geographies> ;
    rdfs:subClassOf prov:Entity , geo:Feature .

dob:PostcodeUnitArea a rdf:Class , owl:Class ;
    rdfs:label "Postcode Unit Area"@en ;
    rdfs:comment "The area designated by a postcode unit, which is usually either several addresses or a single major delivery point. Postcodes were designed to aid in delivering mail."@en ;
    rdfs:seeAlso <https://www.royalmail.com/find-a-postcode> ;
    rdfs:subClassOf prov:Entity , geo:Feature .

dob:PostcodeUnit a rdf:Class, owl:Class ;
    rdfs:label "Postcode Unit"@en ;
    rdfs:comment "A full postcode, which identifies a region with several addresses."@en ;
    rdfs:seeAlso <https://www.royalmail.com/find-a-postcode> ;
    rdfs:subClassOf prov:Entity , geo:Feature .

dob:PostalSector a rdf:Class, owl:Class ;
	rdfs:label "Postal Sector"@en ;
	rdfs:comment "A subdivision of a postal district, combining the outward and the first digit of the inward code."@en ;
	rdfs:seeAlso <https://www.royalmail.com/find-a-postcode> ;
	rdfs:subClassOf prov:Entity , geo:Feature .

dob:PostalDistrict a rdf:Class, owl:Class ;
	rdfs:label "Postal District"@en ;
	rdfs:comment "A subdivision of a postal area used by the Royal Mail to facilitate mail delivery, identified by the outward code in a postcode."@en ;
	rdfs:seeAlso <https://www.royalmail.com/find-a-postcode> ;
	rdfs:subClassOf prov:Entity , geo:Feature .

dob:PostalArea a rdf:Class, owl:Class ;
	rdfs:label "Postal Area Code"@en ;
	rdfs:comment "The largest unit in the UK postcode hierarchy, typically consisting of one or two letters and representing a broad geographical area."@en ;
	rdfs:seeAlso <https://www.royalmail.com/find-a-postcode> ;
	rdfs:subClassOf prov:Entity , geo:Feature .

dob:Ward a rdf:Class , owl:Class ;
    rdfs:label "Ward Area"@en ;
    rdfs:comment "An electoral district within a local authority area, used for electing local councillors."@en ;
    rdfs:seeAlso <https://www.ons.gov.uk/methodology/geography/ukgeographies/administrativegeography/england#electoral-wardselectoral-divisions> ;
    rdfs:subClassOf prov:Entity , geo:Feature .

dob:LocalAuthority a rdf:Class , owl:Class ;
	rdfs:label "Local Authority Area"@en ;
	rdfs:comment "An administrative body responsible for local governance, such as a borough, city council, or unitary authority."@en ;
	rdfs:seeAlso <https://www.ons.gov.uk/methodology/geography/ukgeographies/administrativegeography/england> ;
	rdfs:subClassOf prov:Entity , geo:Feature .

dob:LondonBorough a rdf:Class, owl:Class ;
	rdfs:label "London Borough Code"@en ;
	rdfs:comment "An administrative district that makes up Greater London."@en ;
	rdfs:seeAlso <https://www.ons.gov.uk/methodology/geography/ukgeographies/censusgeographies/census2021geographies> ;
	rdfs:subClassOf dob:LocalAuthority .

dob:Region a rdf:Class, owl:Class ;
	rdfs:label "Region Code"@en ;
	rdfs:comment "A principal administrative subdivision within a country, as defined by that country’s own administrative structure. For example, England is divided into nine such regions."@en ;
	rdfs:seeAlso <https://www.ons.gov.uk/methodology/geography/ukgeographies/censusgeographies/census2021geographies> ;
	rdfs:subClassOf prov:Entity , geo:Feature.

dob:Country a rdfs:Class , owl:Class ;
    rdfs:label "Country"@en ;
	rdfs:comment "A sovereign state or nation."@en ;
    rdfs:subClassOf prov:Entity , geo:Feature .

#########################################################
### Identifier Classes
#########################################################

dob:TOIDValue a rdf:Class, owl:Class ;
    rdfs:label "Topographic Identifier (UPRN)"@en ;
    rdfs:comment "The unique topographical identifier for building polygons from OS MasterMap."@en ;
    rdfs:seeAlso <https://www.ordnancesurvey.co.uk/products/os-open-toid> ;
    rdfs:subClassOf adms:Identifier .

dob:UPRNValue a rdf:Class, owl:Class ;
    rdfs:label "Unique Property Reference Number (UPRN)"@en ;
    rdfs:comment "A unique numeric identifier for a spatial addressable location in Great Britain, as defined by the Ordnance Survey. Used to unambiguously reference properties across datasets."@en ;
    skos:example "A UPRN is a unique numeric identifier, e.g., 100012345678, used to reference a single spatial addressable location."@en ;
    rdfs:seeAlso <https://www.ordnancesurvey.co.uk/public/unique-property-reference-numbers> ;
    rdfs:subClassOf adms:Identifier .

dob:ODSValue a rdf:Class, owl:Class ;
    rdfs:label "NHS Organisation Data Service (ODS) Identifier"@en ;
    rdfs:comment "An identifier assigned by NHS Digital for organisations involved in health and social care across England and associated services. Used for consistent referencing across health datasets."@en ;
    skos:note "Use dob:recommendationCodeAddress to indicate the system’s confidence in automated matching of ODS identifiers."@en ;
    rdfs:seeAlso <https://www.odsdatasearchandexport.nhs.uk/> ;
    rdfs:subClassOf adms:Identifier .

dob:UDPRNValue a rdfs:Class , owl:Class ;
    rdfs:label "Unique Delivery Point Reference Number"@en ;
    rdfs:comment "A Unique Delivery Point Reference Number (UDPRN) is a unique identifier assigned to each delivery point in the UK, used for postal and delivery purposes."@en ;
    rdf:subClassOf adms:Identifier .

dob:USRNValue a rdfs:Class , owl:Class ;
    rdfs:label "Unique Street Reference Number"@en ;
    rdfs:comment "Unique Street Reference Number (USRN) used to identify streets and paths in Great Britain."@en ;
    rdf:subClassOf adms:Identifier .

dob:OACode a rdf:Class, owl:Class ;
    rdfs:label "ONS Output Area Identifier"@en ;
    rdfs:comment "Identifying codes for ONS output areas for statistical geography."@en ;
    rdfs:seeAlso <https://www.ons.gov.uk/methodology/geography/ukgeographies/censusgeographies/census2021geographies> ;
    rdfs:subClassOf adms:Identifier .

dob:LSOACode a rdf:Class, owl:Class ;
    rdfs:label "ONS Lower Layer Super Output Area Identifier"@en ;
    rdfs:comment "Identifying codes for ONS lower layer super output areas for statistical geography."@en ;
    rdfs:seeAlso <https://www.ons.gov.uk/methodology/geography/ukgeographies/censusgeographies/census2021geographies> ;
    rdfs:subClassOf adms:Identifier .

dob:MSOACode a rdf:Class, owl:Class ;
    rdfs:label "ONS Middle Layer Super Output Area Identifier"@en ;
    rdfs:comment "Identifying codes for ONS middle layer super output areas for statistical geography."@en ;
    rdfs:seeAlso <https://www.ons.gov.uk/methodology/geography/ukgeographies/censusgeographies/census2021geographies> ;
    rdfs:subClassOf adms:Identifier .

dob:PostalSectorCode a rdf:Class, owl:Class ;
	rdfs:label "Postal Sector Code"@en ;
	rdfs:comment "A code representing the outward code and the first digit of the inward code in UK postcodes."@en ;
	rdfs:seeAlso <https://www.royalmail.com/find-a-postcode> ;
	rdfs:subClassOf adms:Identifier .

dob:PostalDistrictCode a rdf:Class, owl:Class ;
	rdfs:label "Postal District Code"@en ;
	rdfs:comment "A code combining the postal area with a numeric or alphanumeric district, used in outward postcodes."@en ;
	rdfs:seeAlso <https://www.royalmail.com/find-a-postcode> ;
	rdfs:subClassOf adms:Identifier .

dob:PostalAreaCode a rdf:Class, owl:Class ;
	rdfs:label "Postal Area Code"@en ;
	rdfs:comment "A one- or two-letter code representing a large geographic area in the UK postcode system."@en ;
	rdfs:seeAlso <https://www.royalmail.com/find-a-postcode> ;
	rdfs:subClassOf adms:Identifier .

dob:WardCode a rdf:Class, owl:Class ;
    rdfs:label "Ward Code"@en ;
    rdfs:comment "A unique identifier created by the ONS to classify wards in the UK."@en ;
    rdfs:seeAlso <https://www.ons.gov.uk/methodology/geography/ukgeographies/censusgeographies/census2021geographies> ;
    rdfs:subClassOf adms:Identifier .

dob:LondonBoroughCode a rdf:Class, owl:Class ;
	rdfs:label "London Borough Code"@en ;
	rdfs:comment "An ONS-assigned identifier for the 32 London boroughs and the City of London."@en ;
	rdfs:seeAlso <https://www.ons.gov.uk/methodology/geography/ukgeographies/censusgeographies/census2021geographies> ;
	rdfs:subClassOf adms:Identifier .

dob:ISO3166-1Code a rdf:Class, owl:Class ;
	rdfs:label "ISO 3166-1 Code"@en ;
	rdfs:comment "International standard code designating countries and dependent territories."@en ;
	rdfs:seeAlso <https://www.iso.org/iso-3166-country-codes.html> ;
	rdfs:subClassOf adms:Identifier .

#########################################################
### Core Properties (a full list is found in prop/index.ttl)
#########################################################

dop:describes a rdf:Property , owl:ObjectProperty ;
    rdfs:label "Describes"@en ;
    rdfs:comment "A property that relates a result to the entity the result provides information about."@en ;
    so:domainIncludes dob:Result ;
    so:rangeIncludes sosa:FeatureOfInterest , geo:Feature , prov:Entity .

dop:relationType a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "Relation Type" ;
    rdfs:comment "Associates the qualified class with the relation being described." ;
    so:domainIncludes dob:QualifiedIdentifier, dob:QualifiedGeospatialRelation ;
    so:rangeIncludes xsd:string .

dop:relatesFeature a rdf:Property , owl:ObjectProperty ;
    rdfs:label "Relates Feature" ; 
    rdfs:comment "The secondary geo:Feature described by the geospatial relation." ;
    so:domainIncludes dob:QualifiedGeospatialRelation ;
    so:rangeIncludes geo:Feature .

dop:relatesIdentifier a rdf:Property , owl:ObjectProperty ;
    rdfs:label "Relates Identifier" ; 
    rdfs:comment "The identifier being qualified." ;
    so:domainIncludes dob:QualifiedIdentifier ;
    so:rangeIncludes adms:Identifier .

dop:recommendationCode a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "Matching Recommendation Code"@en ;
    rdfs:comment "A general-purpose recommendation or confidence code used to qualify the strength or reliability of identifier matching."@en ;
    so:domainIncludes dob:QualifiedIdentifier ;
    so:rangeIncludes xsd:string .