@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix did: <https://w3id.org/dob/id/> .
@prefix dob: <https://w3id.org/dob/voc#> .
@prefix dop: <https://w3id.org/dob/voc/prop#> .
@prefix dob-concept: <https://w3id.org/dob/voc/concept#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix so: <http://schema.org/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix sdmx-attribute:  <http://purl.org/linked-data/sdmx/2009/attribute#> .
@prefix sdmx-concept:  <http://purl.org/linked-data/sdmx/2009/concept#> .
@prefix sdmx-measure:  <http://purl.org/linked-data/sdmx/2009/measure#> .
@prefix qb4st: <https://www.w3.org/TR/qb4st/> .
@prefix ifc: <https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2_TC1/OWL#> .

#########################################################################
### Asset Data
#########################################################################

dop:lidarSignalPano
    a rdf:Property, owl:ObjectProperty ;
    rdfs:label "Signal LiDAR Panorama" ;
    rdfs:comment "Panorama image generated from raw LiDAR signal return." ;
    rdfs:subPropertyOf so:contentURL ;
    so:domainIncludes sosa:Result, dob:Result ;
    so:rangeIncludes xsd:anyURI ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Lidar> .

dop:lidarPointcloudMerged
    a rdf:Property, owl:ObjectProperty ;
    rdfs:label "ICP Merged Pointcloud" ;
    rdfs:comment "Point cloud created by merging multiple LiDAR scans using ICP algorithm." ;
    rdfs:subPropertyOf so:contentURL ;
    so:domainIncludes sosa:Result, dob:Result ;
    so:rangeIncludes xsd:anyURI .

dop:lidarReflectancePano
    a rdf:Property, owl:ObjectProperty ;
    rdfs:label "Reflectance LiDAR Panorama" ;
    rdfs:comment "LiDAR panorama showing reflectance intensity values." ;
    rdfs:subPropertyOf so:contentURL ;
    so:domainIncludes sosa:Result, dob:Result ;
    so:rangeIncludes xsd:anyURI ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Lidar#Reflectance> .

dop:lidarPointcloudFrame
    a rdf:Property, owl:ObjectProperty ;
    rdfs:label "Single Pointcloud: Centre File" ;
    rdfs:comment "Single LiDAR scan representing a centered frame in time and space." ;
    rdfs:subPropertyOf so:contentURL ;
    so:domainIncludes sosa:Result, dob:Result ;
    so:rangeIncludes xsd:anyURI .

dop:lidarNearIRPano
    a rdf:Property, owl:ObjectProperty ;
    rdfs:label "NearIR LiDAR Panorama" ;
    rdfs:comment "LiDAR panorama filtered to near-infrared wavelength bands." ;
    rdfs:subPropertyOf so:contentURL ;
    so:domainIncludes sosa:Result, dob:Result ;
    so:rangeIncludes xsd:anyURI ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Near-infrared_spectroscopy> .

dop:lidarRangePano
    a rdf:Property, owl:ObjectProperty ;
    rdfs:label "Range LiDAR Panorama" ;
    rdfs:comment "Distance/range panorama image encoded from LiDAR data." ;
    rdfs:subPropertyOf so:contentURL ;
    so:domainIncludes sosa:Result, dob:Result ;
    so:rangeIncludes xsd:anyURI .

dop:irCountImage
    a rdf:Property, owl:ObjectProperty ;
    rdfs:label "IR Count Image" ;
    rdfs:comment "Raw infrared image representing counts before calibration." ;
    rdfs:subPropertyOf so:contentURL ;
    so:domainIncludes sosa:Result, dob:Result ;
    so:rangeIncludes xsd:anyURI ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Thermographic_camera> .

dop:irFalseColorImage
    a rdf:Property, owl:ObjectProperty ;
    rdfs:label "False Color IR Image" ;
    rdfs:comment "Infrared image colorized to enhance human visual interpretation." ;
    rdfs:subPropertyOf so:contentURL ;
    so:domainIncludes sosa:Result, dob:Result ;
    so:rangeIncludes xsd:anyURI .

dop:irTemperatureArray
    a rdf:Property, owl:ObjectProperty ;
    rdfs:label "Compressed NumPy Temperature Array" ;
    rdfs:comment "Binary NumPy array (.npy or .npz) containing temperature data." ;
    rdfs:subPropertyOf so:contentURL ;
    so:domainIncludes sosa:Result, dob:Result ;
    so:rangeIncludes xsd:anyURI .

dop:temperature
    a rdf:Property, owl:DatatypeProperty, qb:MeasureProperty ;
    rdfs:label "Temperature" ;
    rdfs:comment "Observed temperature measurement." ;
    so:domainIncludes sosa:Result, dob:Result ;
    so:rangeIncludes xsd:double ;
    rdfs:subPropertyOf sdmx-measure:obsValue ;
    qb:concept sdmx-concept:obsValue .

dop:relativeHumidity
    a rdf:Property, owl:DatatypeProperty, qb:MeasureProperty ;
    rdfs:label "Relative Humidity" ;
    rdfs:comment "Relative humidity expressed as a percentage." ;
    so:domainIncludes sosa:Result, dob:Result ;
    so:rangeIncludes xsd:double ;
    rdfs:subPropertyOf sdmx-measure:obsValue ;
    qb:concept sdmx-concept:obsValue .

#########################################################################
### LBSM Dataset
#########################################################################

dop:isModelled a rdf:Property , owl:DatatypeProperty , qb:AttributeProperty ;
    rdfs:label "Is Modelled"@en ;
    rdfs:comment "A property that qualifies whether a Result is modelled or known. The range is expected to be Boolean, where 1 signifies that the data is modelled, and 0 signifies that the data is known (i.e., it has been measured directly)."@en ;
    rdfs:subPropertyOf sdmx-attribute:obsStatus ;
    rdfs:seeAlso so:measurementQualifier ;
    qb:concept sdmx-concept:obsStatus ;
    so:domainIncludes sosa:Result , dob:Result , qb:Observation ;
    so:rangeIncludes xsd:boolean .

dop:describes a rdf:Property , owl:ObjectProperty , qb:DimensionProperty ;
    rdfs:label "Describes"@en ;
    rdfs:comment "A property that relates a result to the entity the result provides information about."@en ;
    so:domainIncludes dob:Result , qb:Observation , sosa:Result ;
    so:rangeIncludes sosa:FeatureOfInterest .

dop:bngEasting a rdf:Property , owl:DatatypeProperty , qb4st:CoordMeasure ;
    rdfs:label "Easting"@en ;
    rdfs:comment "The eastward-measured Cartesian coordinate of a point in the British National Grid."@en ;
    qb4st:crs <http://www.opengis.net/def/crs/EPSG/0/27700> ;
    qb4st:crsaxis "easting" ;
    qb4st:crslabel "British National Grid" ;
    so:domainIncludes dob:Result , qb:Observation , sosa:Result ;
    so:rangeIncludes xsd:float .

dop:bngNorthing a rdf:Property , owl:DatatypeProperty , qb4st:CoordMeasure ;
    rdfs:label "Northing"@en ;
    rdfs:comment "The northward-measured Cartesian coordinate of a point in the British National Grid."@en ;
    qb4st:crs <http://www.opengis.net/def/crs/EPSG/0/27700> ;
    qb4st:crsaxis "northing" ;
    qb4st:crslabel "British National Grid" ;
    so:domainIncludes dob:Result , qb:Observation , sosa:Result ;
    so:rangeIncludes xsd:float .

dop:hasPropertyType a rdf:Property, owl:ObjectProperty , qb:DimensionProperty , qb:CodedProperty ;
    rdfs:label "Has Property Type"@en ;
    rdfs:subPropertyOf dop:hasAccommodationType ;
    rdfs:seeAlso so:accommodationCategory ;
    rdfs:comment "The property type for dwellings. Together with the Build Form field, Property Type produces a structured description of the property."@en ;
    qb:codeList did:propertyType ;
    qb:concept dob-concept:accommodationType ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes did:PropertyType .

dop:hasBuiltForm a rdf:Property, owl:ObjectProperty , qb:DimensionProperty , qb:CodedProperty ;
    rdfs:label "Has Built Form"@en ;
    rdfs:subPropertyOf dop:hasAccommodationType ;
    rdfs:seeAlso so:accommodationCategory ;
    rdfs:comment "The building built form. Together with the Property Type field, the Build Form produces a structured description of the property."@en ;
    qb:codeList did:builtForm ;
    qb:concept dob-concept:accommodationType ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes did:BuiltForm .

dop:hasAccommodationType a rdf:Property, owl:ObjectProperty , qb:DimensionProperty , qb:CodedProperty ;
    rdfs:label "Has Accommodation Type"@en ;
    rdfs:seeAlso so:accommodationCategory ;
    rdfs:comment "The combined property type and built form for dwellings."@en ;
    qb:codeList did:accommodationType ;
    qb:concept dob-concept:accommodationType ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes did:AccommodationType .

dop:hasTenure a rdf:Property, owl:ObjectProperty , qb:DimensionProperty , qb:CodedProperty ;
    rdfs:label "Has Tenure"@en ;
    rdfs:comment "The legal or financial arrangement under which a building or dwelling is occupied."@en ;
    qb:codeList did:tenure ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes did:Tenure .

dop:hasBuildingUse a rdf:Property, owl:ObjectProperty , qb:DimensionProperty , qb:CodedProperty ;
    rdfs:label "Has Building Use"@en ;
    rdfs:seeAlso so:permittedUsage ;
    rdfs:comment "Describes the primary function or usage category of a building."@en ;
    qb:codeList did:buildingUse ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes did:BuildingUse .

dop:constructionAgeBand a rdf:Property, owl:ObjectProperty , qb:DimensionProperty , qb:CodedProperty ;
    rdfs:label "Construction Age Band" ;
    rdfs:seeAlso so:yearBuilt ;
    rdfs:comment "Age band when the feature was constructed."@en ;
    qb:codeList did:timeInterval ;
    qb:concept sdmx-concept:age ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes did:constructionAgeBand .

dop:hasEPCScore a rdf:Property, owl:DatatypeProperty , qb:MeasureProperty ;
    rdfs:label "EPC Score"@en ;
    rdfs:seeAlso so:hasEnergyEfficiencyCategory ;
    rdfs:comment "A numerical representation of the energy efficiency of a building, based on cost of energy, i.e. energy required for space heating, water heating and lighting [in kWh/year] multiplied by fuel costs. (£/m²/year where cost is derived from kWh)."@en ;
    rdfs:seeAlso <https://epc.opendatacommunities.org/> ;
    qb:concept dob-concept:energyEfficiencyEnumeration ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:int .

dop:hasEPCRating a rdf:Property, owl:ObjectProperty , qb:DimensionProperty , qb:CodedProperty ;
    rdfs:label "EPC Rating"@en ;
    rdfs:seeAlso so:hasEnergyEfficiencyCategory ;
    rdfs:comment "Current energy rating converted into a linear 'A to G' rating (where A is the most energy efficient and G is the least energy efficient)"@en ;
    rdfs:seeAlso <https://epc.opendatacommunities.org/> ;
    qb:codeList did:epcRating ;
    qb:concept dob-concept:energyEfficiencyEnumeration ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes did:EPCRating .

dop:hasPotentialEPCScore a rdf:Property, owl:DatatypeProperty , qb:MeasureProperty ;
    rdfs:label "Potential EPC Score"@en ;
    rdfs:seeAlso so:hasEnergyEfficiencyCategory ;
    rdfs:comment "The potential EPC Score."@en ;
    rdfs:seeAlso <https://epc.opendatacommunities.org/> ;
    qb:concept dob-concept:energyEfficiencyEnumeration ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:int .

dop:hasPotentialEPCRating a rdf:Property, owl:ObjectProperty , qb:DimensionProperty , qb:CodedProperty ;
    rdfs:label "Potential EPC Rating"@en ;
    rdfs:seeAlso so:hasEnergyEfficiencyCategory ;
    rdfs:comment "The potential EPC Rating."@en ;
    rdfs:seeAlso <https://epc.opendatacommunities.org/> ;
    qb:codeList did:potentialEPCRating ;
    qb:concept dob-concept:energyEfficiencyEnumeration ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes did:EPCRating .

dop:numberOfHabitableRooms a rdf:Property, owl:DatatypeProperty , qb:MeasureProperty ;
    rdfs:label "Number of Habitable Rooms"@en ;
    rdfs:seeAlso so:numberOfRooms ;
    rdfs:comment "Habitable rooms include any living room, sitting room, dining room, bedroom, study and similar; and also a non-separated conservatory. A kitchen/diner having a discrete seating area (with space for a table and four chairs) also counts as a habitable room. A non-separated conservatory adds to the habitable room count if it has an internal quality door between it and the dwelling. Excluded from the room count are any room used solely as a kitchen, utility room, bathroom, cloakroom, en-suite accommodation and similar and any hallway, stairs or landing; and also any room not having a window."@en ;
    rdfs:seeAlso <https://epc.opendatacommunities.org/docs/guidance> ;
    qb:concept dob-concept:numberOfRooms ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:int .

dop:totalFloorArea a rdf:Property, owl:DatatypeProperty , qb:MeasureProperty ;
    rdfs:label "Total Floor Area" ;
    rdfs:comment "The total useful floor area is the total of all enclosed spaces measured to the internal face of the external walls, i.e. the gross floor area as measured in accordance with the guidance issued from time to time by the Royal Institute of Chartered Surveyors or by a body replacing that institution. (m²)"@en ;
    rdfs:seeAlso so:area , so:floorSize ;
    qb:concept dob-concept:area ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:float .
    
dop:floorCount a rdf:Property, owl:DatatypeProperty , qb:MeasureProperty ;
    rdfs:label "Estimated Floor Count" ;
    rdfs:comment "The estimated number of storeys in a building, inferred from total building height and an assumed floor-to-floor height."@en ;
    qb:concept dob-concept:numberOfFloors ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:int .

dop:basementFloorCount a rdf:Property, owl:DatatypeProperty , qb:MeasureProperty ;
    rdfs:label "Basement Floor Count" ;
    rdfs:comment "Indicates the presence and number of known basement floors in the building."@en ;
    qb:concept dob-concept:numberOfFloors ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:int .

dop:hasWallType a rdf:Property, owl:ObjectProperty , qb:DimensionProperty , qb:CodedProperty ;
    rdfs:label "Has Wall Type" ;
    rdfs:seeAlso ifc:predefinedType_IfcWallType ;
    rdfs:comment "The property's wall construction type."@en ;
    qb:codeList did:wallType ;
    qb:concept dob-concept:buildingElementType ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes did:WallType .

dop:hasWallInsulation a rdf:Property, owl:DatatypeProperty , qb:DimensionProperty ;
    rdfs:label "Has Wall Insulation" ;
    rdfs:seeAlso ifc:predefinedType_IfcBuildingElementPartType ;
    rdfs:comment "Denotes whether the property's walls are insulated."@en ;
    qb:concept dob-concept:insulation ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:boolean .

dop:hasRoofType a rdf:Property, owl:ObjectProperty , qb:DimensionProperty , qb:CodedProperty ;
    rdfs:label "Has Roof Type" ;
    rdfs:seeAlso ifc:predefinedType_IfcRoofType ;
    rdfs:comment "The property's roof type."@en ;
    qb:codeList did:roofType ;
    qb:concept dob-concept:buildingElementType ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes did:RoofType .

dop:hasRoofInsulation a rdf:Property, owl:DatatypeProperty , qb:DimensionProperty ;
    rdfs:label "Has Roof Insulation" ;
    rdfs:seeAlso ifc:predefinedType_IfcBuildingElementPartType ;
    rdfs:comment "Denotes whether the property's roof is insulated."@en ;
    qb:concept dob-concept:insulation ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes did:RoofInsulation .

dop:hasGlazingType a rdf:Property, owl:ObjectProperty , qb:DimensionProperty , qb:CodedProperty ;
    rdfs:label "Has Glazing Type" ;
    rdfs:seeAlso ifc:predefinedType_IfcBuildingElementPartType ;
    rdfs:comment "The property's glazing type."@en ;
    qb:codeList did:glazingType ;
    qb:concept dob-concept:buildingElementType , dob-concept:insulation ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes did:GlazingType .

dop:hasMainHeatingSystem a rdf:Property, owl:ObjectProperty , qb:DimensionProperty , qb:CodedProperty ;
    rdfs:label "Has Main Heating System" ;
    rdfs:seeAlso ifc:predefinedType_IfcDistributionSystemType ;
    rdfs:comment "The property's main heating system."@en ;
    qb:codeList did:heatingSystem ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes did:MainHeatType .

dop:hasMainFuelType a rdf:Property, owl:ObjectProperty , qb:DimensionProperty , qb:CodedProperty ;
    rdfs:label "Has Main Fuel Type" ;
    rdfs:comment "The primary fuel used to heat the property."@en ;
    qb:codeList did:fuelType ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes did:MainFuelType .

dop:energyConsumption a rdf:Property, owl:DatatypeProperty , qb:MeasureProperty ;
    rdfs:label "Energy Consumption" ;
    rdfs:seeAlso ifc:IfcEnergyMeasure ;
    rdfs:comment "Current estimated total energy demand for the property in a 12 month period."@en ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:float .

dop:solarPVArea a rdf:Property, owl:DatatypeProperty , qb:MeasureProperty ;
    rdfs:label "Solar PV Area" ;
    rdfs:seeAlso so:area ;
    rdfs:comment "The estimated area of the building's roof surface where the annual potential is greater than 700kWh per metre square and the slope is less than 65°."@en ;
    rdfs:seeAlso <https://apps.london.gov.uk/lsom/> ;
    qb:concept dob-concept:area , dob-concept:solarPV ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:float .

dop:solarPVPotential a rdf:Property, owl:DatatypeProperty , qb:MeasureProperty ;
    rdfs:label "Solar PV Potential" ;
    rdfs:comment "The estimated annual solar PV output in kWh for the building's viable roof area based on an assumed efficiency of 11.9%."@en ;
    rdfs:seeAlso <https://apps.london.gov.uk/lsom/> ;
    qb:concept dob-concept:solarPV ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:float .

dop:averageRoofTilt a rdf:Property, owl:DatatypeProperty , qb:MeasureProperty ; 
    rdfs:label "Average Roof Tilt" ;
    rdfs:comment "The average tilt of the building's roof."@en ;
    rdfs:seeAlso <https://apps.london.gov.uk/lsom/> ;
    qb:concept dob-concept:geometry, dob-concept:solarPV ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:float .

dop:imd19NationalDecile a rdf:Property, owl:DatatypeProperty , qb:DimensionProperty ;
    rdfs:label "IMD19 National Decile" ;
    rdfs:comment "The LSOA’s decile (out of all LSOAs in England) based on the 2019 Index of Multiple Deprivation (IMD) score."@en ;
    rdfs:seeAlso <https://www.gov.uk/government/collections/english-indices-of-deprivation> ;
    qb:concept: dob-concept:sociodemographicIndex ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:int .

dop:imd19IncomeDecile a rdf:Property, owl:DatatypeProperty , qb:DimensionProperty ;
    rdfs:label "IMD19 Income Decile" ;
    rdfs:comment "The LSOA’s decile (out of all LSOAs in England) based on the 2019 Index of Multiple Deprivation (IMD) income deprivation domain."@en ;
    rdfs:seeAlso <https://www.gov.uk/government/collections/english-indices-of-deprivation> ;
    qb:concept: dob-concept:sociodemographicIndex ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:int .

dop:loacSupergroup a rdf:Property, owl:ObjectProperty , qb:DimensionProperty , qb:CodedProperty ;
    rdfs:label "LOAC Supergroup" ;
    rdfs:comment "The 2021 London Output Area Classification (LOAC) supergroup."@en ;
    qb:codeList did:loacSupergroup ;
    rdfs:seeAlso <https://data.london.gov.uk/dataset/london-output-area-classification/> ;
    qb:concept dob-concept:sociodemographicClassification ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes did:LOACSupergroup .

dop:loacGroup a rdf:Property, owl:ObjectProperty , qb:DimensionProperty , qb:CodedProperty ;
    rdfs:label "LOAC Group" ;
    rdfs:comment "The 2021 London Output Area Classification (LOAC) group."@en ;
    qb:codeList did:loacGroup ;
    rdfs:seeAlso <https://data.london.gov.uk/dataset/london-output-area-classification/> ;
    qb:concept dob-concept:sociodemographicClassification ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes did:LOACGroup .

dop:fuelPoverty a rdf:Property, owl:DatatypeProperty , qb:MeasureProperty ;
    rdfs:label "Fuel Poverty" ;
    rdfs:comment "The proportion of households within the LSOA that are in fuel poverty. Based on 2024 sub-regional data from DESNZ."@en ;
    rdfs:seeAlso <https://www.gov.uk/government/statistics/sub-regional-fuel-poverty-2024-2022-data/sub-regional-fuel-poverty-in-england-2024-2022-data> ;
    qb:concept: dob-concept:sociodemographicIndex ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:float .

dop:heatRiskQuintile a rdf:Property, owl:DatatypeProperty , qb:DimensionProperty  ;
    rdfs:label "Heat Risk Quintile" ;
    rdfs:comment "The heat risk for residential properties in the wake of climate change. The risk is split into quintiles and is based on the 'Properties Vulnerable to Heat Impact' report produced by Arup for the GLA."@en ;
    rdfs:seeAlso <https://data.london.gov.uk/dataset/properties-vulnerable-to-heat-impacts-in-london/> , <https://www.london.gov.uk/programmes-strategies/environment-and-climate-change/environment-and-climate-change-publications/properties-vulnerable-to-heat-impact-report> ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:int .

dop:listedBuildingGrade a rdf:Property, owl:ObjectProperty , qb:DimensionProperty , qb:CodedProperty ;
    rdfs:label "Listed Building Grade" ;
    rdfs:comment "Listed building grade for properties that could be linked to their Historic England records."@en ;
    qb:codeList did:listedBuildingGrade ;
    rdfs:seeAlso <https://historicengland.org.uk/listing/the-list/data-downloads/> ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes dob:ListedBuildingGrade .

dop:inConservationArea a rdf:Property , owl:DatatypeProperty , qb:AttributeProperty ;
    rdfs:label "Conservation Area Flag" ;
    rdfs:comment "Denotes whether the property is in a conservation area."@en ;
    rdfs:seeAlso <https://www.planning.data.gov.uk/dataset/conservation-area> ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:boolean .

dop:conservationSiteID a rdf:Property, owl:DatatypeProperty , qb:DimensionProperty ;
    rdfs:label "Conservation Site ID" ;
    rdfs:comment "Unique ID for the conservation area which can be used to identify properties in the same conservation area. This ID is specific to the London Building Stock Model."@en ;
    rdfs:seeAlso <https://www.planning.data.gov.uk/dataset/conservation-area> , <https://data.london.gov.uk/dataset/london-building-stock-model-2/> ;
    so:domainIncludes dob:Result , qb:Observation ;
    so:rangeIncludes xsd:string .